body {
  background: skyblue url('https://www.transparenttextures.com/patterns/bubbles.png');
  font-family: 'Tahoma', sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

#quiz-container {
  background: #fff;
  padding: 25px;
  border-radius: 12px;
  width: 600px;
  text-align: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

h1 {
  color: #000;
  font-size: 22px;
}

#question {
  font-size: 20px;
  color: #000;
  margin-bottom: 15px;
  font-weight: bold;
}

.option {
  display: block;
  background: #eee;
  margin: 10px 0;
  padding: 15px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 20px;
  font-weight: 700;
  color: purple;
  transition: 0.3s;
}

.option:hover {
  background: #dcdcdc;
}

.option.correct {
  background: #4CAF50;
  color: white;
}

.option.wrong {
  background: #f44336;
  color: white;
}

button {
  background: #0095DD;
  color: #fff;
  border: none;
  padding: 10px 25px;
  margin-top: 15px;
  cursor: pointer;
  border-radius: 6px;
  font-size: 16px;
}

button:hover {
  background: #0077aa;
}

#progress-bar {
  width: 100%;
  background: #ddd;
  border-radius: 8px;
  margin-bottom: 15px;
}

#progress {
  height: 15px;
  width: 0%;
  background: purple;
  border-radius: 8px;
}

.certificate-box {
  border: 2px solid #0077aa;
  padding: 20px;
  margin-top: 15px;
  background: #f0f8ff;
  border-radius: 10px;
}
