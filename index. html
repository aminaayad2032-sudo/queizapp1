<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>اختبار تطور تكنولوجيا المعلومات</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div id="quiz-container">
    <h1>اختبار تطور تكنولوجيا المعلومات</h1>
    <div id="student-input">
      <label>ادخل اسم الطالب:</label>
      <input type="text" id="student-name" placeholder="اسمك هنا">
      <button onclick="startQuiz()">ابدأ الاختبار</button>
    </div>
    <div id="quiz" style="display:none;">
      <div id="progress-bar"><div id="progress"></div></div>
      <div id="question"></div>
      <div id="options"></div>
      <button id="next-btn" onclick="nextQuestion()">التالي</button>
    </div>
    <div id="certificate" style="display:none;">
      <h2>🎉 تهانينا 🎉</h2>
      <p id="congrats"></p>
      <div class="certificate-box">
        <h3>شهادة تقدير</h3>
        <p id="cert-student"></p>
        <p id="final-score"></p>
        <p>إعداد المهندسة أمينة عياد</p>
      </div>
    </div>
    <footer>إعداد المهندسة أمينة عياد</footer>
  </div>
  <script src="script.js"></script>
</body>
</html>
